# Godot's own caches.
.godot/
export_presets.cfg

# The addon is COPIED in by `scons install` from sdk/godot, the same way a game
# consumes a release zip. Committing it would mean committing binaries and
# keeping two copies of the addon in sync.
addons/

# Envelopes packed INTO the project for an export (G15). Outside one, the
# playground reads the examples' `dist/` directly — copying them in permanently
# would leave it rendering a stale build of the very examples it exists to show.
envelopes/

# Exported builds.
build/
