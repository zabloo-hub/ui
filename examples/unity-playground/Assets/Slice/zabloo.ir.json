{
  "v": 1,
  "tokens": {
    "color.primary": "#4f46e5",
    "color.primary.hover": "#6366f1",
    "color.on-primary": "#ffffff",
    "radius.md": 8,
    "space.2": 8,
    "space.4": 16
  },
  "views": {
    "main-menu": {
      "type": "Container",
      "layout": {
        "direction": "column",
        "grow": 1,
        "justify": "center",
        "align": "center",
        "gap": 16
      },
      "children": [
        {
          "type": "Button",
          "id": "buy-btn",
          "layout": {
            "padding": "{space.4}"
          },
          "style": {
            "background": "{color.primary}",
            "radius": "{radius.md}"
          },
          "states": {
            "pressed": {
              "style": {
                "background": "{color.primary.hover}"
              }
            }
          },
          "onClick": "buy",
          "children": [
            {
              "type": "Text",
              "style": {
                "color": "{color.on-primary}",
                "fontSize": 24
              },
              "text": "Comprar"
            }
          ]
        },
        {
          "type": "Collapse",
          "id": "options",
          "layout": {
            "padding": "{space.2}",
            "gap": 8
          },
          "style": {
            "background": "#1f2430",
            "radius": "{radius.md}"
          },
          "open": false,
          "children": [
            {
              "type": "Text",
              "style": {
                "color": "#ffffff",
                "fontSize": 18
              },
              "text": "Opciones"
            },
            {
              "type": "Text",
              "style": {
                "color": "#9aa4b2"
              },
              "text": "Sonido: alto"
            },
            {
              "type": "Text",
              "style": {
                "color": "#9aa4b2"
              },
              "text": "Idioma: es"
            },
            {
              "type": "Text",
              "style": {
                "color": "#9aa4b2"
              },
              "text": "Vibracion: si"
            }
          ]
        }
      ]
    }
  }
}
