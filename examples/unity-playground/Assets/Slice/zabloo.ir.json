{
  "v": 1,
  "tokens": {
    "color.primary": "#4f46e5",
    "color.primary.hover": "#6366f1",
    "color.on-primary": "#ffffff",
    "radius.md": 8,
    "space.2": 8,
    "space.4": 16
  },
  "views": {
    "main-menu": {
      "type": "Container",
      "layout": {
        "direction": "column",
        "grow": 1,
        "justify": "center",
        "align": "center",
        "gap": 16
      },
      "children": [
        {
          "type": "Container",
          "layout": {
            "direction": "row",
            "gap": 8
          },
          "children": [
            {
              "type": "Text",
              "style": {
                "color": "#facc15",
                "fontSize": 20
              },
              "text": "Oro:"
            },
            {
              "type": "Text",
              "style": {
                "color": "#facc15",
                "fontSize": 20
              },
              "text": {
                "bind": "player.gold"
              }
            }
          ]
        },
        {
          "type": "Container",
          "layout": {
            "direction": "row",
            "gap": 12
          },
          "children": [
            {
              "type": "Button",
              "id": "buy-btn",
              "layout": {
                "padding": "{space.4}"
              },
              "style": {
                "background": "{color.primary}",
                "radius": "{radius.md}"
              },
              "states": {
                "pressed": {
                  "style": {
                    "background": "{color.primary.hover}"
                  }
                },
                "focused": {
                  "style": {
                    "background": "#7c86f2"
                  }
                }
              },
              "autofocus": true,
              "onClick": "buy",
              "children": [
                {
                  "type": "Text",
                  "style": {
                    "color": "{color.on-primary}",
                    "fontSize": 24
                  },
                  "text": "Comprar"
                }
              ]
            },
            {
              "type": "Button",
              "id": "quit-btn",
              "layout": {
                "padding": "{space.4}"
              },
              "style": {
                "background": "#2f3446",
                "radius": "{radius.md}"
              },
              "states": {
                "pressed": {
                  "style": {
                    "background": "#3b4160"
                  }
                },
                "focused": {
                  "style": {
                    "background": "#4a5170"
                  }
                }
              },
              "onClick": "quit",
              "children": [
                {
                  "type": "Text",
                  "style": {
                    "color": "#c8cede",
                    "fontSize": 24
                  },
                  "text": "Salir"
                }
              ]
            }
          ]
        },
        {
          "type": "Text",
          "visible": {
            "bind": "shop.thanked"
          },
          "style": {
            "color": "#4ade80"
          },
          "text": "Gracias por tu compra"
        },
        {
          "type": "Collapse",
          "id": "options",
          "layout": {
            "padding": "{space.2}",
            "gap": 8
          },
          "style": {
            "background": "#1f2430",
            "radius": "{radius.md}"
          },
          "open": false,
          "children": [
            {
              "type": "Text",
              "style": {
                "color": "#ffffff",
                "fontSize": 18
              },
              "states": {
                "focused": {
                  "style": {
                    "color": "#a5b4fc"
                  }
                }
              },
              "text": "Opciones"
            },
            {
              "type": "Text",
              "style": {
                "color": "#9aa4b2"
              },
              "text": "Sonido: alto"
            },
            {
              "type": "Text",
              "style": {
                "color": "#9aa4b2"
              },
              "text": "Idioma: es"
            },
            {
              "type": "Text",
              "style": {
                "color": "#9aa4b2"
              },
              "text": "Vibracion: si"
            }
          ]
        },
        {
          "type": "Container",
          "id": "menu",
          "layout": {
            "direction": "column",
            "gap": 4
          },
          "group": "exclusive-open",
          "children": [
            {
              "type": "Collapse",
              "id": "missions",
              "layout": {
                "padding": "{space.2}",
                "gap": 8
              },
              "style": {
                "background": "#1f2430",
                "radius": "{radius.md}"
              },
              "open": true,
              "children": [
                {
                  "type": "Text",
                  "style": {
                    "color": "#ffffff",
                    "fontSize": 18
                  },
                  "states": {
                    "focused": {
                      "style": {
                        "color": "#a5b4fc"
                      }
                    }
                  },
                  "text": "Misiones"
                },
                {
                  "type": "Text",
                  "style": {
                    "color": "#9aa4b2"
                  },
                  "text": "Derrota al dragon"
                },
                {
                  "type": "Text",
                  "style": {
                    "color": "#9aa4b2"
                  },
                  "text": "Recoge 10 gemas"
                }
              ]
            },
            {
              "type": "Collapse",
              "id": "inventory",
              "layout": {
                "padding": "{space.2}",
                "gap": 8
              },
              "style": {
                "background": "#1f2430",
                "radius": "{radius.md}"
              },
              "open": false,
              "children": [
                {
                  "type": "Text",
                  "style": {
                    "color": "#ffffff",
                    "fontSize": 18
                  },
                  "states": {
                    "focused": {
                      "style": {
                        "color": "#a5b4fc"
                      }
                    }
                  },
                  "text": "Inventario"
                },
                {
                  "type": "Text",
                  "style": {
                    "color": "#9aa4b2"
                  },
                  "text": "Espada de hierro"
                },
                {
                  "type": "Text",
                  "style": {
                    "color": "#9aa4b2"
                  },
                  "text": "Pocion x3"
                }
              ]
            },
            {
              "type": "Collapse",
              "id": "social",
              "layout": {
                "padding": "{space.2}",
                "gap": 8
              },
              "style": {
                "background": "#1f2430",
                "radius": "{radius.md}"
              },
              "open": false,
              "children": [
                {
                  "type": "Text",
                  "style": {
                    "color": "#ffffff",
                    "fontSize": 18
                  },
                  "states": {
                    "focused": {
                      "style": {
                        "color": "#a5b4fc"
                      }
                    }
                  },
                  "text": "Social"
                },
                {
                  "type": "Text",
                  "style": {
                    "color": "#9aa4b2"
                  },
                  "text": "3 amigos conectados"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
