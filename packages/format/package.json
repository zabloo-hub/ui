{
  "name": "@zabloo/format",
  "version": "0.3.0",
  "description": "The zabloo IR format: TypeScript types and envelope validation",
  "license": "MIT",
  "keywords": [
    "zabloo",
    "game-ui",
    "gamedev",
    "ui",
    "ir",
    "intermediate-representation",
    "envelope",
    "engine-agnostic"
  ],
  "homepage": "https://github.com/zabloo-hub/ui/tree/main/packages/format#readme",
  "bugs": "https://github.com/zabloo-hub/ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zabloo-hub/ui.git",
    "directory": "packages/format"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
