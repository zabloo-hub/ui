{
  "name": "@zabloo/cli",
  "version": "0.2.0",
  "description": "zabloo/ui CLI: export React projects as versioned IR envelopes, validate them, and preview them live",
  "license": "MIT",
  "keywords": [
    "zabloo",
    "cli",
    "game-ui",
    "gamedev",
    "ui",
    "export",
    "preview",
    "validate",
    "dev-server",
    "engine-agnostic"
  ],
  "homepage": "https://github.com/zabloo-hub/ui/tree/main/packages/cli#readme",
  "bugs": "https://github.com/zabloo-hub/ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zabloo-hub/ui.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "zabloo": "./dist/cli.js",
    "zb": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean --sourcemap && node scripts/copy-preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zabloo/format": "workspace:*",
    "@zabloo/renderer-web": "workspace:*",
    "commander": "^15.0.0",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@zabloo/preview": "workspace:*"
  }
}
