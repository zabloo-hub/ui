"""Builds the Zabloo GDExtension: the shared core plus a thin Godot adapter.

    scons                      a debug build for the host platform
    scons target=template_release
    scons platform=macos arch=universal

`godot-cpp` comes in as a submodule and brings its own SConstruct, which is what
decides the platform, the architecture and the flags — this file only adds
sources to the environment it hands back.

The core's own .cpp files are compiled straight into the extension rather than
linked from `core/bin/`: one set of flags for both halves, and no static library
built with a different toolchain than the one godot-cpp chose. `core/SConstruct`
still builds it alone, which is what the `core-tests` job needs — the core has to
be buildable without any of this.
"""

import os
import subprocess
import sys

env = SConscript("godot-cpp/SConstruct")

# A Command Line Tools install upgraded across a macOS release can end up with
# the SDKs current and the toolchain's own libc++ a husk — the headers are in the
# SDK and clang looks for them next to itself, so <cstddef> stops existing. Same
# fallback as `core/SConstruct`, applied to the environment godot-cpp handed back
# (SCons resolves construction variables at build time, so it reaches its objects
# as well as ours).
# Guarded on the TARGET and not just the host: a web, Android or iOS build runs on
# this same Mac with a toolchain that brings its own libc++, and pointing it at the
# macOS SDK's headers is how a wasm compile ends up failing on macOS availability
# macros. Only a macOS build wants the macOS SDK.
if sys.platform == "darwin" and env["platform"] == "macos":
    sdk = subprocess.run(
        ["xcrun", "--show-sdk-path"], capture_output=True, text=True, check=False
    ).stdout.strip()
    toolchain = os.path.join(
        os.path.dirname(env.WhereIs("c++") or "/usr/bin/c++"), "..", "include", "c++", "v1"
    )
    sdk_libcxx = os.path.join(sdk, "usr", "include", "c++", "v1") if sdk else ""
    if (
        sdk_libcxx
        and not os.path.exists(os.path.join(toolchain, "cstddef"))
        and os.path.exists(os.path.join(sdk_libcxx, "cstddef"))
    ):
        env.Append(CXXFLAGS=["-cxx-isystem", sdk_libcxx])

core = os.path.join("..", "..", "core", "src")
env.Append(CPPPATH=[core, "src"])


def core_object(source, shared=True):
    """Compiles one of the core's sources INTO THIS DIRECTORY.

    The target path is spelled out rather than left to SCons, which would put the
    object next to its source — inside `core/src/`, where `core/SConstruct` keeps
    its own. Most platforms name a shared object `.os` and the two coexist by
    luck; the web toolchain names it `.o`, so a web build quietly replaced every
    native object with a wasm one and the next `scons` in `core/` died on
    "archive member 'assets.o' not a mach-o file" — naming a file that had nothing
    to do with anything. A foreign build has no business leaving artifacts in
    another directory, whatever the suffix.
    """
    stem = os.path.splitext(os.path.relpath(str(source), core))[0]
    target = os.path.join("obj", "core", stem)
    return (env.SharedObject if shared else env.StaticObject)(target=target, source=source)


# `core/src/generated/` is the embedded TTF the text engine rasterizes (G4).
sources = Glob("src/*.cpp") + [
    core_object(source)
    for source in Glob(os.path.join(core, "*.cpp")) + Glob(os.path.join(core, "generated", "*.cpp"))
]

# The vendored rasterizer, on the same terms `core/SConstruct` gives it: warnings
# off (it is not ours to keep clean) and hidden visibility (an engine may carry
# its own copy of stb, and two of them resolving to one another is the divergence
# core-owned rasterization exists to prevent). See its own file for the rest.
vendor_env = env.Clone()
vendor_env["CXXFLAGS"] = [flag for flag in vendor_env["CXXFLAGS"] if not str(flag).startswith("-W")]
if env.get("CC") == "cl":
    vendor_env.Append(CXXFLAGS=["/w"])
else:
    vendor_env.Append(CXXFLAGS=["-w", "-fvisibility=hidden"])
sources += vendor_env.SharedObject(
    target=os.path.join("obj", "core", "vendor", "stb_truetype_impl"),
    source=os.path.join(core, "vendor", "stb_truetype_impl.cpp"),
)

# The name carries the platform and the target because a `.gdextension` lists one
# library per (platform, target) and loads the one that matches at runtime.
suffix = env["suffix"]
library = env.SharedLibrary(
    "addons/zabloo/bin/libzabloo{}{}".format(suffix, env["SHLIBSUFFIX"]),
    source=sources,
)

Default(library)


def install_addon(target, source, env):
    """`scons install` — puts the addon where a game would unzip a release."""
    import shutil

    into = os.path.join("..", "..", "examples", "godot-playground", "addons", "zabloo")
    if os.path.exists(into):
        shutil.rmtree(into)
    shutil.copytree("addons/zabloo", into)
    print("installed the addon into examples/godot-playground/addons/zabloo")
    return None


if "install" in COMMAND_LINE_TARGETS:
    installer = env.Command("install-addon", library, install_addon)
    env.AlwaysBuild(installer)
    env.Alias("install", installer)
